 CAF benefits I am entitled to.","latin":"","arp":""}]},{"id":"xmw9n96s44j2l","flag":"🇫🇷","lang":"fr","text":"Est-ce que vous travaillez actuellement ?","latin":"","arp":"","meaning":"","en":"","note":"","rows":[{"flag":"🇸🇾","lang":"ar","text":"هل تعمل حالياً؟","latin":"","arp":""},{"flag":"🇺🇸","lang":"en","text":"Are you currently working?","latin":"","arp":""}]},{"id":"xmw9n96s47ja3","flag":"🇫🇷","lang":"fr","text":"Oui, je travaille actuellement, mais mes revenus sont limités.","latin":"","arp":"","meaning":"","en":"","note":"","rows":[{"flag":"🇸🇾","lang":"ar","text":"نعم، عم اشتغل حالياً، بس دخلي محدود.","latin":"","arp":""},{"flag":"🇺🇸","lang":"en","text":"Yes, I am currently working, but my income is limited.","latin":"","arp":""}]},{"id":"xmw9n96s4z7vf","flag":"🇫🇷","lang":"fr","text":"Quelle est votre situation familiale ?","latin":"","arp":"","meaning":"","en":"","note":"","rows":[{"flag":"🇸🇾","lang":"ar","text":"شو وضعك العائلي؟","latin":"","arp":""},{"flag":"🇺🇸","lang":"en","text":"What is your family situation?","latin":"","arp":""}]},{"id":"xmw9n96s4pjqy","flag":"🇫🇷","lang":"fr","text":"Je suis célibataire et je n’ai pas d’enfants.","latin":"","arp":"","meaning":"","en":"","note":"","rows":[{"flag":"🇸🇾","lang":"ar","text":"أنا أعزب وما عندي أطفال.","latin":"","arp":""},{"flag":"🇺🇸","lang":"en","text":"I am single and I have no children.","latin":"","arp":""}]},{"id":"xmw9n96s4lsp5","flag":"🇫🇷","lang":"fr","text":"Est-ce que vous avez un logement ?","latin":"","arp":"","meaning":"","en":"","note":"","rows":[{"flag":"🇸🇾","lang":"ar","text":"هل عندك سكن؟","latin":"","arp":""},{"flag":"🇺🇸","lang":"en","text":"Do you have accommodation?","latin":"","arp":""}]},{"id":"xmw9n96s4nqo7","flag":"🇫🇷","lang":"fr","text":"Je suis actuellement hébergé temporairement et je recherche un logement stable.","latin":"","arp":"","meaning":"","en":"","note":"","rows":[{"flag":"🇸🇾","lang":"ar","text":"أنا حالياً مقيم بسكن مؤقت وعم دور على سكن مستقر.","latin":"","arp":""},{"flag"