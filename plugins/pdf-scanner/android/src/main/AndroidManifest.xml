<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 10 (API 29) and below: classic shared-storage read access -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 11+ (API 30+): required to enumerate PDF documents created
         by other apps through MediaStore / direct file access -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application android:requestLegacyExternalStorage="true">
        <!-- Reuses Capacitor's ${applicationId}.fileprovider (covers the whole cache dir) -->
    </application>
</manifest>
